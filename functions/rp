#!/bin/zsh
#
# GitHub repository management tool
# - Require: ghq, fzf
#


local action="${1:-cd}"

_repo_tmux_open() {
    local mode="$1"
    local target_path="$2"
    local name="$(basename "$target_path")"
    name="${name//./_}"

    if [[ "$mode" == "session" ]]; then
        if tmux has-session -t "$name" 2>/dev/null; then
            echo "Session '$name' already exists. Switching to it."
        else
            tmux new-session -d -s "$name" -c "$target_path"
            echo "Created tmux session: $name"
        fi
        tmux switch-client -t "$name" 2>/dev/null || tmux attach -t "$name"
    elif [[ "$mode" == "window" ]]; then
        tmux new-window -c "$target_path"
    fi
}

case "$action" in
    "list"|"l")
        # List all repositories with fzf selection
        local selected_repo
        selected_repo=$(ghq list | fzf --height=~20% --preview="eza $(ghq root)/{} --color=always" --preview-window=down:3:wrap)
        if [[ -n "$selected_repo" ]]; then
            echo "Selected: $selected_repo"
            echo "Path: $(ghq root)/$selected_repo"
        fi
        ;;
    "cd"|"c")
        # Change directory to selected repository
        local tmux_mode=""
        if [[ "$2" == "-s" ]]; then
            tmux_mode="session"
            shift
        elif [[ "$2" == "-w" ]]; then
            tmux_mode="window"
            shift
        fi
        local selected_repo
        selected_repo=$(ghq list | fzf --height=~20% --preview="eza $(ghq root)/{} --color=always" --preview-window=down:3:wrap)
        if [[ -n "$selected_repo" ]]; then
            local full_path="$(ghq root)/$selected_repo"
            if [[ -n "$tmux_mode" ]]; then
                _repo_tmux_open "$tmux_mode" "$full_path"
            else
                cd "$full_path" || return 1
            fi
        fi
        ;;
    "remove"|"rm"|"r")
        # Remove selected repository
        local selected_repo
        selected_repo=$(ghq list | fzf --height=50% --preview="eza $(ghq root)/{} --color=always" --preview-window=down:3:wrap --prompt="Select repository to remove: ")
        if [[ -n "$selected_repo" ]]; then
            printf "Are you sure you want to remove %s? (y/n [y]) " "$selected_repo"
            read -r confirm
            if [[ -z "$confirm" || "$confirm" =~ ^[Yy](es)?$ ]]; then
                echo "yes"
                rm -rf "$(ghq root)/$selected_repo"
                echo "Removed: $selected_repo"
            else
                echo "no"
                echo "Cancelled"
            fi
        fi
        ;;
    "get"|"g")
        # Clone/get a new repository
        local tmux_mode=""
        if [[ "$2" == "-s" ]]; then
            tmux_mode="session"
            shift
        elif [[ "$2" == "-w" ]]; then
            tmux_mode="window"
            shift
        fi
        local full_path
        if [[ -z "$2" ]]; then
            # Interactive mode: show remote repositories via gh + fzf
            local selected_repo
            selected_repo=$(gh repo list --limit 100 --json nameWithOwner --jq '.[].nameWithOwner' | fzf --height=50% --preview="gh repo view {} --json description,url,pushedAt --template '{{.description}}\n{{.url}}\nLast updated: {{.pushedAt}}'" --preview-window=down:5:wrap --prompt="Select repository to clone: ")
            if [[ -n "$selected_repo" ]]; then
                full_path="$(ghq root)/github.com/$selected_repo"
                ghq get "github.com/$selected_repo"
                if [[ -z "$tmux_mode" ]]; then
                    cd "$full_path"
                fi
            fi
        else
            # Normalize URL to path format for ghq
            local repo_path="$2"
            repo_path="${repo_path#https://}"
            repo_path="${repo_path#http://}"
            repo_path="${repo_path#git@}"
            repo_path="${repo_path/://}"
            repo_path="${repo_path%.git}"
            # Remove GitHub-specific paths (/tree/branch, /blob/branch, etc.)
            repo_path="${repo_path%%/tree/*}"
            repo_path="${repo_path%%/blob/*}"
            # Add github.com prefix for short form (user/repo)
            local first_segment="${repo_path%%/*}"
            if [[ "$first_segment" != *.* ]]; then
                repo_path="github.com/$repo_path"
            fi

            full_path="$(ghq root)/$repo_path"
            ghq get "$2"
            if [[ -z "$tmux_mode" ]]; then
                cd "$full_path"
            fi
        fi

        if [[ -n "$tmux_mode" && -n "$full_path" ]]; then
            _repo_tmux_open "$tmux_mode" "$full_path"
        fi
        ;;
    "create"|"new"|"n")
        # Create a new repository directory
        local tmux_mode=""
        if [[ "$2" == "-s" ]]; then
            tmux_mode="session"
            shift
        elif [[ "$2" == "-w" ]]; then
            tmux_mode="window"
            shift
        fi
        if [[ -z "$2" ]]; then
            echo "Usage: repo create [-s|-w] <repository_path>"
            echo "  -s  Create and attach to a new tmux session"
            echo "  -w  Open in a new tmux window"
            echo "Example: repo create user/new-repo"
            return 1
        fi
        local repo_path="$2"
        # Add github.com prefix for short form (user/repo)
        local first_segment="${repo_path%%/*}"
        if [[ "$first_segment" != *.* ]]; then
            repo_path="github.com/$repo_path"
        fi
        local full_path="$(ghq root)/$repo_path"
        mkdir -p "$full_path"
        git -C "$full_path" init
        if [[ -z "$tmux_mode" ]]; then
            cd "$full_path" || return 1
        fi
        echo "Created and initialized: $repo_path"

        if [[ -n "$tmux_mode" ]]; then
            _repo_tmux_open "$tmux_mode" "$full_path"
        fi
        ;;
    "open"|"o")
        # Open repository in editor (default: code)
        local editor="${2:-code}"
        local selected_repo
        selected_repo=$(ghq list | fzf --height=50% --preview="eza $(ghq root)/{} --color=always" --preview-window=down:3:wrap)
        if [[ -n "$selected_repo" ]]; then
            local repo_path="$(ghq root)/$selected_repo"
            if command -v "$editor" > /dev/null; then
                "$editor" "$repo_path"
            else
                echo "Editor '$editor' not found. Trying fallback editors..."
                if command -v code > /dev/null; then
                    code "$repo_path"
                elif command -v vim > /dev/null; then
                    vim "$repo_path"
                else
                    echo "No suitable editor found (code, vim)"
                fi
            fi
        fi
        ;;
    "help"|"h"|*)
        # Show help
        cat << 'EOF'
Repository management with ghq and fzf

Usage: repo <command> [args]

Commands:
  list, l              List repositories with fzf selection
  cd, c [-s|-w]        Change directory to selected repository
                       Use -s to create and attach to a tmux session
                       Use -w to open in a new tmux window
  remove, rm, r        Remove selected repository (with confirmation)
  get, g [-s|-w] [url] Clone repository (interactive if no url)
                       Use -s to create and attach to a tmux session
                       Use -w to open in a new tmux window
  create, new, n [-s|-w]  Create and initialize a new repository
                       Use -s to create and attach to a tmux session
                       Use -w to open in a new tmux window
  open, o [editor]     Open repository in editor (default: code)
  help, h              Show this help message

Examples:
  repo                    # List repositories and change to the selected repository
  repo cd                 # Change to selected repository
  repo cd -s              # Change to selected repository in tmux session
  repo cd -w              # Change to selected repository in new tmux window
  repo get                # Interactive repository selection
  repo get github.com/user/repo
  repo get -s user/repo   # Clone and attach to tmux session
  repo get -w user/repo   # Clone and open in new tmux window
  repo create github.com/user/new-repo
  repo create -s user/new-repo  # Create and attach to tmux session
  repo create -w user/new-repo  # Create and open in new tmux window
  repo remove             # Remove selected repository
  repo open               # Open repository in code (default)
  repo open vim           # Open repository in vim
  repo open nvim          # Open repository in neovim

Requirements: ghq, fzf, git, gh (for interactive get)
EOF
            ;;
esac
