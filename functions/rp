#!/bin/zsh
#
# GitHub repository management tool
# - Require: ghq, fzf, git
#


local BOLD=$'\033[1m'
local GREEN=$'\033[0;32m'
local YELLOW=$'\033[0;33m'
local CYAN=$'\033[0;36m'
local GRAY=$'\033[38;5;242m'
local NC=$'\033[0m'

local action="${1:-hub}"
local query=""
case "$action" in
    hub|list|ls|cd|c|path|p|remove|rm|r|get|g|create|new|n|open|o|help|h)
        ;;
    -*)
        action="help"
        ;;
    *)
        query="$action"
        action="cd"
        ;;
esac

# Required commands. This file is autoloaded, so this never runs at shell startup.
if [[ "$action" != "help" ]]; then
    local -a missing=()
    local cmd
    for cmd in ghq fzf git; do
        (( $+commands[$cmd] )) || missing+=("$cmd")
    done
    if (( $#missing )); then
        print -u2 "rp: missing required command(s): ${(j:, :)missing}"
        return 1
    fi
fi

_repo_require() {
    # Same message shape as the startup check above, for commands that only
    # some subcommands need.
    local -a lacking=()
    local c
    for c in "$@"; do
        (( $+commands[$c] )) || lacking+=("$c")
    done
    (( $#lacking )) || return 0
    print -u2 "rp: missing required command(s): ${(j:, :)lacking}"
    return 1
}

_repo_tmux_open() {
    local mode="$1"
    local target_path="$2"
    local name="$(basename "$target_path")"
    name="${name//./_}"

    if [[ "$mode" == "session" ]]; then
        if tmux has-session -t "$name" 2>/dev/null; then
            echo "Session '$name' already exists. Switching to it."
        else
            tmux new-session -d -s "$name" -c "$target_path"
            echo "Created tmux session: $name"
        fi
        tmux switch-client -t "$name" 2>/dev/null || tmux attach -t "$name"
    elif [[ "$mode" == "window" ]]; then
        tmux new-window -c "$target_path"
    fi
}

_repo_parse_tmux_opt() {
    case "$1" in
        -s|--tmux-session)
            tmux_mode="session"
            return 0
            ;;
        -w|--tmux-window)
            tmux_mode="window"
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

_repo_herdr_open() {
    local mode="$1"
    local target_path="$2"
    local name="$(basename "$target_path")"
    name="${name//./_}"

    if [[ "$mode" == "session" ]]; then
        # workspace = tmux session 相当。label 一致で冪等に focus、無ければ create
        local existing
        existing=$(herdr workspace list 2>/dev/null \
            | jq -r --arg l "$name" '.result.workspaces[] | select(.label == $l) | .workspace_id' \
            | head -1)
        if [[ -n "$existing" ]]; then
            herdr workspace focus "$existing" > /dev/null || return 1
            echo "Focused herdr workspace: $name"
        else
            herdr workspace create --cwd "$target_path" --label "$name" --focus > /dev/null || return 1
            echo "Created herdr workspace: $name"
        fi
    elif [[ "$mode" == "window" ]]; then
        # tab = tmux window 相当。tmux 版同様、毎回新規
        herdr tab create --cwd "$target_path" --label "$name" --focus > /dev/null || return 1
        echo "Created herdr tab: $name"
    fi
}

_repo_mux_open() {
    local mode="$1"
    local target_path="$2"
    # herdr の中なら herdr、それ以外は tmux（in/out 両対応）
    if [[ -n "$HERDR_ENV" ]]; then
        # jq は `herdr workspace list` を読む session 側でしか使わない。
        local -a needed=(herdr)
        [[ "$mode" == "session" ]] && needed+=(jq)
        _repo_require "$needed[@]" || return 1
        _repo_herdr_open "$mode" "$target_path"
    else
        _repo_require tmux || return 1
        _repo_tmux_open "$mode" "$target_path"
    fi
}

_repo_editor_open() {
    # One ordered chain, first command on PATH wins:
    #   rp open <editor>  ->  $RP_EDITOR  ->  $VISUAL  ->  $EDITOR
    #                     ->  code  ->  vim  ->  nvim
    # Every candidate is split, so a value carrying arguments works
    # (RP_EDITOR="code -n", EDITOR="code --wait") and only its first word is
    # looked up. Without the split, reading $EDITOR would silently skip anyone
    # whose $EDITOR has a flag in it.
    #   "${(@z)x}"  not  ${(z)x}:  an unquoted expansion is globbed under the
    #     user's glob_subst, and rp keeps the options of the shell it is
    #     autoloaded into.
    #   command -v  not  $+commands[...]:  the latter is a PATH hash and never
    #     holds an absolute path, so it would reject EDITOR=/usr/bin/vim.
    local target_path="$1"
    local requested="${2:-}"
    local -a parts
    # Only an explicit `rp open <editor>` is worth reporting when it is
    # missing. The rest of the chain is a fallback list; skipping it is its job.
    if [[ -n "$requested" ]]; then
        parts=("${(@z)requested}")
        command -v "$parts[1]" > /dev/null ||
            print -u2 "rp: editor not found: $requested"
    fi
    local -a candidates=("$requested" "$RP_EDITOR" "$VISUAL" "$EDITOR" code vim nvim)
    local editor
    for editor in "$candidates[@]"; do
        [[ -n "$editor" ]] || continue
        parts=("${(@z)editor}")
        command -v "$parts[1]" > /dev/null || continue
        "$parts[@]" "$target_path"
        return
    done
    print -u2 "rp: no editor found (tried ${(j:, :)${(@)candidates:#}})"
    return 1
}

_repo_open_dest() {
    # Destination axis: where a repository gets opened, independent of the
    # operation that produced it. Shared by the -s/-w branches and the hub.
    # Never call this from $(...) or a subshell: the `here` cd would be lost.
    local dest="$1"
    local target_path="$2"
    case "$dest" in
        here)
            cd "$target_path" || return 1
            ;;
        session|window)
            _repo_mux_open "$dest" "$target_path"
            ;;
        editor)
            _repo_editor_open "$target_path" "$3"
            ;;
    esac
}

_repo_qualify_host() {
    # Add github.com prefix for short form (user/repo)
    local repo_path="$1"
    local first_segment="${repo_path%%/*}"
    if [[ "$first_segment" != *.* ]]; then
        repo_path="github.com/$repo_path"
    fi
    print -r -- "$repo_path"
}

_repo_create() {
    local repo_path="$1"
    local full_path="$(ghq root)/$repo_path"
    mkdir -p "$full_path" || return 1
    git -C "$full_path" init || return 1
    echo "Created and initialized: $repo_path"
}

_repo_remove_confirmed() {
    local selected_repo="$1"
    printf "Are you sure you want to remove %s? (y/n [y]) " "$selected_repo"
    local confirm
    read -r confirm
    if [[ -z "$confirm" || "$confirm" =~ ^[Yy](es)?$ ]]; then
        rm -rf "$(ghq root)/$selected_repo"
        echo "Removed: $selected_repo"
    else
        echo "Cancelled"
    fi
}

_repo_copy_path() {
    # Print the path either way, so the value survives a missing clipboard tool.
    local target_path="$1"
    local cmd
    for cmd in pbcopy wl-copy xclip; do
        (( $+commands[$cmd] )) || continue
        case "$cmd" in
            xclip) printf %s "$target_path" | xclip -selection clipboard ;;
            *)     printf %s "$target_path" | $cmd ;;
        esac
        print -r -- "$target_path"
        return 0
    done
    print -u2 "rp: no clipboard command found (tried pbcopy, wl-copy, xclip)"
    print -r -- "$target_path"
    return 1
}

_repo_hub_new_name() {
    # ^R carries the picker's query out to become a repository name. Validate
    # it here, before anything touches the disk.
    local name="${1%/}"
    if [[ -z "$name" ]]; then
        print -u2 "rp: repository name is empty"
        return 1
    fi
    if [[ "$name" == /* || "$name" == *//* ]]; then
        print -u2 "rp: invalid repository name: $name"
        return 1
    fi
    local -a parts=("${(@s:/:)name}")
    if (( $#parts < 2 )); then
        print -u2 "rp: repository name must be <user>/<repo>: $name"
        return 1
    fi
    local p
    for p in "$parts[@]"; do
        # Rejects spaces and every shell metacharacter. A leading - is safe:
        # only the absolute path is ever passed as an argument.
        if [[ ! "$p" =~ ^[A-Za-z0-9._-]+$ ]]; then
            print -u2 "rp: unsupported character in $name (allowed: letters digits . _ -)"
            return 1
        fi
        if [[ "$p" == "." || "$p" == ".." ]]; then
            print -u2 "rp: invalid path component in $name"
            return 1
        fi
    done
    _repo_qualify_host "$name"
}

_repo_preview() {
    # Resolves the preview templates once. Writes preview_local /
    # preview_remote into the caller's scope, the way _repo_parse_tmux_opt
    # writes $tmux_mode.
    #
    # Template contract, the one the hub already used internally: {} is the
    # selected host/user/repo and $RP_ROOT is the ghq root, so every caller
    # exports RP_ROOT for fzf's child shell. The local defaults are
    # single-quoted for that reason -- $RP_ROOT has to reach the child, not be
    # expanded here. The remote default is double-quoted instead, because its
    # gh template needs literal {{ }} and single quotes of its own.
    #
    # --preview-window is not resolved here: each picker keeps its own default
    # at its own call site, and RP_PREVIEW_WINDOW overrides all of them.
    preview_local="$RP_PREVIEW_CMD"
    if [[ -z "$preview_local" ]]; then
        if (( $+commands[eza] )); then
            preview_local='eza "$RP_ROOT"/{} --color=always'
        else
            preview_local='ls -la "$RP_ROOT"/{}'
        fi
    fi
    preview_remote="$RP_PREVIEW_REMOTE_CMD"
    [[ -n "$preview_remote" ]] ||
        preview_remote="gh repo view {} --json description,url,pushedAt --template '{{.description}}\n{{.url}}\nLast updated: {{.pushedAt}}'"
}

# Written by _repo_preview, which the picker branches call. Declared here so
# the branches do not each have to; nothing reads RP_PREVIEW* until one does.
local preview_local="" preview_remote=""

_repo_key_label() {
    # fzf key name -> footer label. Anything that is not a plain ctrl- or alt-
    # chord (f5, shift-delete, ctrl-alt-x) is shown verbatim: inventing ^M-X
    # would be less recognisable than the name the user typed.
    # The case patterns are source literals, so the value is only ever the
    # subject of the match, never a pattern.
    local key="$1"
    case "$key" in
        ctrl-?) print -r -- "^${(U)key#ctrl-}" ;;
        alt-?)  print -r -- "M-${key#alt-}" ;;
        *)      print -r -- "$key" ;;
    esac
}

_repo_hub_footer() {
    # key label ... -> one footer line. The key carries the colour and the
    # label stays dim: a footer is scanned for the key, not read.
    # Re-emitted inside change-footer(...), so the result must stay one line
    # and contain none of  +  )  }
    # Keys reach this from RP_KEY_*, so that is enforced upstream, by the
    # whitelist in _repo_hub_keys_validate rather than by anything here.
    # GREEN before BOLD, never the reverse: GREEN starts with a 0 (reset all),
    # which would switch the bold straight back off.
    local out=""
    while (( $# )); do
        [[ -n "$out" ]] && out+="  "
        out+="${GREEN}${BOLD}$1${NC} ${GRAY}$2${NC}"
        shift 2
    done
    print -r -- "$out"
}

_repo_hub_menu() {
    # Stage 2: the operation x destination product, flattened into one
    # searchable list. Prints a single action token. $1 is "repo" for an
    # existing pick, "create" for a name that does not exist yet.
    # $label_session / $label_window come from the hub branch's scope, the way
    # _repo_parse_tmux_opt writes $tmux_mode into its caller's.
    local mode="$1"
    local rel="$2"
    local root="$(ghq root)"
    local -a items=()
    # A herdr plugin popup does not outlive the picker, so cd-ing it changes
    # nothing the user can see (herdr/pane.zsh sets RP_NO_CD).
    [[ -n "$RP_NO_CD" ]] || items+=("here"$'\t'"cd here")
    items+=(
        "session"$'\t'"new $label_session"
        "window"$'\t'"new $label_window"
        "editor"$'\t'"open in editor"
    )
    # Copying a path and removing a clone both need one on disk.
    if [[ "$mode" == "repo" && -e "$root/$rel/.git" ]]; then
        items+=("path"$'\t'"copy path" "remove"$'\t'"remove")
    fi

    # The prompt states an implicit clone or create once, so no label has to.
    local prompt="$rel > "
    if [[ "$mode" == "create" ]]; then
        prompt="create $rel > "
    elif [[ ! -e "$root/$rel/.git" ]]; then
        prompt="clone $rel > "
    fi

    # id<TAB>label: --with-nth displays the label, --accept-nth dispatches the
    # id. The id is invisible and unsearchable, so rewording a label cannot
    # change behaviour.
    print -rl -- "$items[@]" |
        fzf --height=~40% \
            --delimiter="\t" --with-nth=2 --accept-nth=1 \
            --prompt="$prompt" \
            --footer="$(_repo_hub_footer esc cancel)" --footer-border
}

# Hub actions in footer order. Never iterate an associative array to build the
# footer: hash order is arbitrary, and this order is deliberate.
local -a rp_key_ids=(session window actions new remove toggle)

_repo_hub_keys() {
    # Resolves the hub key bindings. Writes keys / klabs into the caller's
    # scope, the way _repo_parse_tmux_opt writes $tmux_mode.
    #
    # Never fails, and validates nothing: `rp help` renders these labels and
    # has to work in a broken environment, which is why it also skips the
    # required-command check above. _repo_hub_keys_validate is the gate, and
    # only the hub calls it.
    #
    # Spelled out rather than looped over RP_KEY_${(U)id}, so that grepping
    # this file for RP_KEY_SESSION finds the line that reads it. Empty means
    # default, not "unbind": dropping a key would have to drop its footer entry
    # too, and RP_KEY_REMOVE=f12 already parks one out of the way.
    keys=(
        session "${RP_KEY_SESSION:-ctrl-s}"
        window  "${RP_KEY_WINDOW:-ctrl-t}"
        actions "${RP_KEY_ACTIONS:-ctrl-o}"
        new     "${RP_KEY_NEW:-ctrl-r}"
        remove  "${RP_KEY_REMOVE:-ctrl-x}"
        toggle  "${RP_KEY_TOGGLE:-ctrl-g}"
    )
    # Resolved once here rather than per use: the footers, the ghost and the
    # no-gh message all need a label, and precomputing is what makes a
    # rebound key unable to drift from the text advertising it.
    local id
    for id in "$rp_key_ids[@]"; do
        klabs[$id]="$(_repo_key_label "$keys[$id]")"
    done
}

_repo_hub_keys_validate() {
    # One whitelist does three jobs that fzf will not do for us. "Is this a
    # real key" is not among them -- fzf answers that itself, with
    # "unsupported key: f13" -- so this does not duplicate its key table. It
    # only buys an error that names the variable at fault.
    #
    #   1. A key is interpolated into --bind "<key>:print(x)+accept", so
    #      RP_KEY_SESSION='ctrl-s:abort,ctrl-x:execute(id)' installs bindings
    #      nobody wrote, and fzf accepts it. That is the user's own shell, with
    #      one real exception: rp exists to jump into arbitrary cloned
    #      repositories, and a repository's .envrc is somebody else's input.
    #   2. A label reaches a footer that gets re-emitted inside
    #      change-footer(...) (see _repo_hub_footer and $toggle below). Letters,
    #      digits and - cannot produce the `)+` or `),` that would end that
    #      action list early. Constraining the key is what keeps the footer safe
    #      by construction, instead of encoding one fzf version's parser quirks
    #      as a list of forbidden characters.
    #   3. Duplicates, which fzf takes silently -- see the enter seed below.
    #
    # The charset excludes ctrl-\ , ctrl-] , alt-<punctuation> and bare
    # punctuation keys, so the error names what is allowed rather than leaving
    # the exclusion a mystery.
    #
    # enter is not configurable, but it shares this namespace: fzf keeps one
    # binding per key and reports nothing, so a collision would quietly disable
    # either enter or the configured action while the footer still advertised
    # both.
    local -A taken=(enter "enter, which is not configurable")
    local id name val
    for id in "$rp_key_ids[@]"; do
        name="RP_KEY_${(U)id}"
        val="$keys[$id]"
        if [[ ! "$val" =~ ^[A-Za-z0-9-]+$ ]]; then
            # (q+) not (qq): (qq) renders an embedded newline as a real line
            # break, which would split the message. -r is then required to
            # keep it one line, because plain print would interpret the \n
            # that (q+) just produced and put the break back.
            print -ru2 "rp: $name: unsupported key name: ${(q+)val}"
            print -u2 "rp: allowed: letters digits - (e.g. ctrl-s, alt-x, f5, shift-delete)"
            return 1
        fi
        # An associative-array subscript is never glob-expanded. The right-hand
        # side of [[ $a == $b ]] would be, under the user's glob_subst, where
        # ctrl-s matches a stray * and reports a duplicate that is not there.
        if [[ -n "$taken[$val]" ]]; then
            print -u2 "rp: $name: $val is already taken by $taken[$val]"
            return 1
        fi
        taken[$val]="$name"
    done
}

_repo_hub_pick() {
    # Stage 1: pick the repository. Writes hub_query / hub_action / hub_repo
    # into the caller's scope. Returns 130 when cancelled, 1 on failure.
    local root="$(ghq root)"

    local -A keys klabs
    _repo_hub_keys
    _repo_hub_keys_validate || return 1

    local -i have_gh=0
    (( $+commands[gh] )) && have_gh=1

    # Read the list once: "no repositories" is a state worth naming, and it
    # must not be mistaken for a cancelled picker.
    local -a repos
    repos=(${(f)"$(ghq list)"})     # unquoted: empty output must give 0 elements

    local cmd_local='ghq list'
    # 2>&1 so a failing gh listing shows its own error in the list, where the
    # user is already looking, instead of silently emptying it.
    local cmd_remote='gh repo list --limit 100 --json nameWithOwner --jq ".[].nameWithOwner" 2>&1'

    # In a popup that does not outlive the picker there is nothing to cd, so
    # enter opens a workspace and the session key would only duplicate it in
    # the guide.
    local -a enter_local=(enter cd "$klabs[session]" "$label_session")
    local -a enter_remote=(enter clone+cd "$klabs[session]" "clone+$label_session")
    if [[ -n "$RP_NO_CD" ]]; then
        enter_local=(enter "$label_session")
        enter_remote=(enter "clone+$label_session")
    fi

    # Labels come from $klabs, never from a literal: a rebound key has to carry
    # its own footer text with it. They no longer need the quoting a literal ^S
    # did -- a parameter expansion in double quotes is not globbed, whatever
    # options the shell rp is autoloaded into happens to have set.
    local footer_local="$(_repo_hub_footer \
        "$enter_local[@]" "$klabs[window]" "$label_window" \
        "$klabs[actions]" actions "$klabs[new]" new "$klabs[remove]" del)"
    local footer_remote="$(_repo_hub_footer \
        "$enter_remote[@]" "$klabs[window]" "clone+$label_window" \
        "$klabs[actions]" actions)"
    if (( have_gh )); then
        footer_local+="  $(_repo_hub_footer "$klabs[toggle]" remote)"
        footer_remote+="  $(_repo_hub_footer "$klabs[toggle]" local)"
    fi

    # fzf runs every template with $SHELL -c, so these bodies are POSIX:
    # `case`, never [[ ]], which breaks under SHELL=/bin/sh. A template
    # carrying `;;` would close this case early, which is why the README says
    # not to put one in RP_PREVIEW_CMD.
    local preview_local preview_remote
    _repo_preview
    local preview="case \"\$FZF_PROMPT\" in remote*) $preview_remote ;; *) $preview_local ;; esac"

    # The toggle key flips the noun source in place. fzf has no variables, so
    # the prompt carries the state and $FZF_PROMPT reaches the transform's
    # child. Every dynamic value arrives through the environment, so nothing
    # here needs shell quoting.
    local toggle='case "$FZF_PROMPT" in remote*) echo "change-prompt($RP_P_LOCAL)+change-footer($RP_F_LOCAL)+reload:$RP_CMD_LOCAL" ;; *) echo "change-prompt($RP_P_REMOTE)+change-footer($RP_F_REMOTE)+reload:$RP_CMD_REMOTE" ;; esac'

    # One --bind per option: the bodies contain commas, and commas separate
    # KEY:ACTION pairs. transform{...} rather than transform(...), because the
    # bind parser counts the delimiter pair and a body containing print(...)
    # would close it early. Plain accept everywhere, never accept-non-empty:
    # that would queue a token without exiting and shift the output lines.
    local enter_dest=here
    [[ -n "$RP_NO_CD" ]] && enter_dest=session
    # Kept in its own single-quoted local, like $toggle above: interpolating
    # the key by making this a double-quoted string would let zsh expand
    # $FZF_QUERY to empty here, and the new-repository key would ring the bell
    # for ever instead of creating anything.
    local new_body='transform{ [ -n "$FZF_QUERY" ] && echo "print(new)+accept" || echo bell }'
    local -a fzf_args=(
        --bind "enter:print($enter_dest)+accept"
        --bind "${keys[session]}:print(session)+accept"
        --bind "${keys[window]}:print(window)+accept"
        --bind "${keys[actions]}:print(menu)+accept"
        --bind "${keys[remove]}:print(remove)+accept"
        --bind "${keys[new]}:$new_body"
    )
    if (( have_gh )); then
        fzf_args+=(--bind "${keys[toggle]}:transform{$toggle}")
    else
        # The guide omits the toggle, but the key should say why rather than do
        # nothing.
        fzf_args+=(--bind "${keys[toggle]}:change-footer:rp: $klabs[toggle] needs gh  $footer_local")
    fi
    # A path may hold any character, so it goes in --header, which is never
    # re-emitted inside an action list.
    (( $#repos )) || fzf_args+=(--header "rp: no repositories under $root")

    local out
    # These RP_* are internal transport into fzf's child shells, not
    # configuration: each one is overwritten here, so setting RP_F_LOCAL in the
    # environment does nothing. Only RP_KEY_*, RP_PREVIEW* and RP_EDITOR are
    # public, plus RP_NO_CD as an input from herdr/pane.zsh.
    out=$( { (( $#repos )) && print -rl -- "$repos[@]" } |
        RP_ROOT="$root" \
        RP_P_LOCAL="local> " RP_P_REMOTE="remote> " \
        RP_F_LOCAL="$footer_local" RP_F_REMOTE="$footer_remote" \
        RP_CMD_LOCAL="$cmd_local" RP_CMD_REMOTE="$cmd_remote" \
        fzf --height=~50% \
            --print-query \
            --prompt="local> " \
            --ghost="filter, or type a new name and press $klabs[new]" \
            --footer="$footer_local" \
            --footer-border \
            --preview="$preview" \
            --preview-window="${RP_PREVIEW_WINDOW:-down:5:wrap}" \
            "$fzf_args[@]" )
    local -i rc=$?

    # 0 vs 1 carries no information: ^R on a query that matches nothing exits 1
    # and is still a legitimate create. 130 is esc. Anything else is fzf itself
    # failing, e.g. an unknown option on an fzf older than 0.63.
    if (( rc == 130 )); then
        return 130
    elif (( rc != 0 && rc != 1 )); then
        return 1
    fi

    #   line 1  query      always, from --print-query
    #   line 2  token      queued by print(...) on any normal exit
    #   line 3  selection  only when a match was accepted
    # The quoted (@f) form is required: the query line is legitimately empty,
    # and ${(f)"$(...)"} would drop it and shift every field.
    local -a lines=("${(@f)out}")
    hub_query="${lines[1]:-}"
    hub_action="${lines[2]:-}"
    hub_repo="${lines[3]:-}"

    case "$hub_action" in
        here|session|window|menu|new|remove)
            ;;
        *)
            print -u2 "rp: unexpected picker output: ${(qq)hub_action}"
            return 1
            ;;
    esac
}

case "$action" in
    "hub")
        # Noun-verb entry point: pick the repository first, then the action on
        # it. Declared before _repo_hub_pick runs, which writes into this scope.
        local hub_query="" hub_action="" hub_repo=""
        local hub_root="$(ghq root)"
        # -s/-w mean herdr inside herdr and tmux outside, so the guide has to
        # name whichever one it will actually create.
        local label_session="session" label_window="window"
        if [[ -n "$HERDR_ENV" ]]; then
            label_session="workspace"
            label_window="tab"
        fi

        _repo_hub_pick
        local -i pick_rc=$?
        (( pick_rc == 130 )) && return 0    # esc: the silent cancel the other pickers do
        (( pick_rc == 0 )) || return 1

        local hub_rel="" hub_dest="" hub_full=""
        if [[ "$hub_action" == "new" ]]; then
            hub_rel=$(_repo_hub_new_name "$hub_query") || return 1
            # The menu runs before anything is created, so an esc here leaves
            # nothing behind.
            hub_dest=$(_repo_hub_menu create "$hub_rel")
            # 1/130 mean nothing was chosen. Anything else is the menu itself
            # failing, which must not be mistaken for a cancel — same split
            # _repo_hub_pick makes.
            case $? in
                0) ;;
                1|130) return 0 ;;
                *) return 1 ;;
            esac
            [[ -n "$hub_dest" ]] || return 0
            hub_full="$hub_root/$hub_rel"
            if [[ -e "$hub_full" ]]; then
                print -u2 "rp: $hub_rel already exists"
                return 1
            fi
            _repo_create "$hub_rel" || return 1
            _repo_open_dest "$hub_dest" "$hub_full"
            return
        fi

        [[ -n "$hub_repo" ]] || return 0
        # ghq list gives host/user/repo, gh repo list gives user/repo.
        hub_rel=$(_repo_qualify_host "$hub_repo")
        if [[ "$hub_action" == "menu" ]]; then
            hub_dest=$(_repo_hub_menu repo "$hub_rel")
            case $? in
                0) ;;
                1|130) return 0 ;;
                *) return 1 ;;
            esac
            [[ -n "$hub_dest" ]] || return 0
        else
            hub_dest="$hub_action"
        fi
        hub_full="$hub_root/$hub_rel"

        # Clone first if the pick has none yet, which a ^G pick never does.
        # Test .git rather than the directory: an interrupted clone leaves a
        # bare directory behind, and .git may be a file in a worktree.
        case "$hub_dest" in
            path|remove)
                ;;
            *)
                if [[ ! -e "$hub_full/.git" ]]; then
                    if [[ ! "$hub_rel" =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+$ ]]; then
                        print -u2 "rp: not a repository: ${(qq)hub_repo}"
                        print -u2 "rp: if this is a gh error, check: gh auth status"
                        return 1
                    fi
                    ghq get "$hub_rel" || return 1
                fi
                ;;
        esac

        case "$hub_dest" in
            path)
                _repo_copy_path "$hub_full"
                ;;
            remove)
                if [[ ! -e "$hub_full/.git" ]]; then
                    print -u2 "rp: not a clone, refusing to remove: $hub_rel"
                    return 1
                fi
                _repo_remove_confirmed "$hub_rel"
                ;;
            *)
                _repo_open_dest "$hub_dest" "$hub_full"
                ;;
        esac
        ;;
    "list"|"ls")
        # List all repositories with fzf selection
        local selected_repo
        _repo_preview
        selected_repo=$(ghq list | RP_ROOT="$(ghq root)" fzf --height=~20% --preview="$preview_local" --preview-window="${RP_PREVIEW_WINDOW:-down:3:wrap}")
        if [[ -n "$selected_repo" ]]; then
            echo "Selected: $selected_repo"
            echo "Path: $(ghq root)/$selected_repo"
        fi
        ;;
    "cd"|"c")
        # Change directory to selected repository
        local tmux_mode=""
        _repo_parse_tmux_opt "$2" && shift
        local fuzzy_query="${query:-$2}"
        local selected_repo
        if [[ -n "$fuzzy_query" ]]; then
            # Non-interactive fuzzy match: pick best result
            selected_repo=$(ghq list | fzf --filter="$fuzzy_query" | head -1)
        else
            # Interactive mode: open fzf selector
            _repo_preview
            selected_repo=$(ghq list | RP_ROOT="$(ghq root)" fzf --height=~20% --preview="$preview_local" --preview-window="${RP_PREVIEW_WINDOW:-down:3:wrap}")
        fi
        if [[ -n "$selected_repo" ]]; then
            _repo_open_dest "${tmux_mode:-here}" "$(ghq root)/$selected_repo"
        fi
        ;;
    "path"|"p")
        # Print the path of the selected repository (no cd; for use in $(...))
        local fuzzy_query="${query:-$2}"
        local selected_repo
        if [[ -n "$fuzzy_query" ]]; then
            # Non-interactive fuzzy match: pick best result
            selected_repo=$(ghq list | fzf --filter="$fuzzy_query" | head -1)
        else
            # Interactive mode: open fzf selector
            _repo_preview
            selected_repo=$(ghq list | RP_ROOT="$(ghq root)" fzf --height=~20% --preview="$preview_local" --preview-window="${RP_PREVIEW_WINDOW:-down:3:wrap}")
        fi
        if [[ -n "$selected_repo" ]]; then
            echo "$(ghq root)/$selected_repo"
        fi
        ;;
    "remove"|"rm"|"r")
        # Remove selected repository
        local selected_repo
        _repo_preview
        selected_repo=$(ghq list | RP_ROOT="$(ghq root)" fzf --height=50% --preview="$preview_local" --preview-window="${RP_PREVIEW_WINDOW:-down:3:wrap}" --prompt="Select repository to remove: ")
        if [[ -n "$selected_repo" ]]; then
            _repo_remove_confirmed "$selected_repo"
        fi
        ;;
    "get"|"g")
        # Clone/get a new repository
        local tmux_mode=""
        _repo_parse_tmux_opt "$2" && shift
        local full_path
        if [[ -z "$2" ]]; then
            # Interactive mode: show remote repositories via gh + fzf
            local selected_repo
            _repo_preview
            selected_repo=$(gh repo list --limit 100 --json nameWithOwner --jq '.[].nameWithOwner' | fzf --height=50% --preview="$preview_remote" --preview-window="${RP_PREVIEW_WINDOW:-down:5:wrap}" --prompt="Select repository to clone: ")
            if [[ -n "$selected_repo" ]]; then
                full_path="$(ghq root)/github.com/$selected_repo"
                ghq get "github.com/$selected_repo" || return 1
            fi
        else
            # Normalize URL to path format for ghq
            local repo_path="$2"
            repo_path="${repo_path#https://}"
            repo_path="${repo_path#http://}"
            repo_path="${repo_path#git@}"
            repo_path="${repo_path/://}"
            repo_path="${repo_path%.git}"
            # Remove GitHub-specific paths (/tree/branch, /blob/branch, etc.)
            repo_path="${repo_path%%/tree/*}"
            repo_path="${repo_path%%/blob/*}"
            repo_path=$(_repo_qualify_host "$repo_path")

            full_path="$(ghq root)/$repo_path"
            ghq get "$2" || return 1
        fi

        if [[ -n "$full_path" ]]; then
            _repo_open_dest "${tmux_mode:-here}" "$full_path"
        fi
        ;;
    "create"|"new"|"n")
        # Create a new repository directory
        local tmux_mode=""
        _repo_parse_tmux_opt "$2" && shift
        if [[ -z "$2" ]]; then
            echo "Usage: rp create [-s|--tmux-session|-w|--tmux-window] <repository_path>"
            echo "  -s, --tmux-session  Open in a new session (tmux session / herdr workspace)"
            echo "  -w, --tmux-window   Open in a new window (tmux window / herdr tab)"
            echo "Example: rp create user/new-repo"
            return 1
        fi
        local repo_path="$(_repo_qualify_host "$2")"
        _repo_create "$repo_path" || return 1
        _repo_open_dest "${tmux_mode:-here}" "$(ghq root)/$repo_path"
        ;;
    "open"|"o")
        # Open repository in editor. An empty $2 lets _repo_editor_open resolve
        # the chain ($RP_EDITOR, $VISUAL, $EDITOR, then code), so no default
        # belongs here.
        local editor="${2:-}"
        local selected_repo
        _repo_preview
        selected_repo=$(ghq list | RP_ROOT="$(ghq root)" fzf --height=50% --preview="$preview_local" --preview-window="${RP_PREVIEW_WINDOW:-down:3:wrap}")
        if [[ -n "$selected_repo" ]]; then
            _repo_open_dest editor "$(ghq root)/$selected_repo" "$editor"
        fi
        ;;
    "help"|"h"|*)
        # Show help.
        # Labels are resolved but deliberately not validated: help is the one
        # action that has to render in a broken environment, which is why it
        # also skips the required-command check at the top of this file.
        local -A keys klabs
        _repo_hub_keys
        # The key column is hand-padded in the heredoc below, which only works
        # while every label is as short as ^S. shift-delete is twelve columns,
        # so build these lines with a width instead. Pad the plain label and
        # wrap the result in colour, never the other way round: a printf width
        # counts the escape bytes.
        local hub_keys="" hk_id hk_text
        for hk_id in enter "$rp_key_ids[@]"; do
            case "$hk_id" in
                enter)   hk_text="cd to the selected repository" ;;
                session) hk_text="Open it as a session (tmux session / herdr workspace)" ;;
                window)  hk_text="Open it in a new window (tmux window / herdr tab)" ;;
                actions) hk_text="Choose from every action, including copy path and remove" ;;
                new)     hk_text="Create the repository named by what you typed" ;;
                remove)  hk_text="Delete it (asks first; refuses anything not cloned)" ;;
                toggle)  hk_text="Switch between local repositories and your GitHub ones" ;;
            esac
            hub_keys+="  ${GREEN}$(printf '%-24s' "${klabs[$hk_id]:-enter}")${NC}${hk_text}"$'\n'
        done
        cat << EOF
${BOLD}Repository management with ghq and fzf${NC}

${CYAN}Usage:${NC} rp <command> [args]

${CYAN}Commands:${NC}
  ${GRAY}(no command),${NC} ${GREEN}hub${NC}       Hub mode: pick a repository first, then choose an action
  ${GREEN}list, ls${NC}                List repositories with fzf selection
  ${GREEN}cd, c${NC} ${YELLOW}[-s|-w] [query]${NC}   Change directory to selected repository
                          If ${YELLOW}query${NC} is given, fuzzy match and cd to best match
                          Use ${YELLOW}-s${NC}, ${YELLOW}--tmux-session${NC} to open a session (tmux session / herdr workspace)
                          Use ${YELLOW}-w${NC}, ${YELLOW}--tmux-window${NC} to open in a new window (tmux window / herdr tab)
  ${GREEN}path, p${NC} ${YELLOW}[query]${NC}         Print path of selected repository (no cd)
                          If ${YELLOW}query${NC} is given, fuzzy match and print best match
  ${GREEN}remove, rm, r${NC}           Remove selected repository (with confirmation)
  ${GREEN}get, g${NC} ${YELLOW}[-s|-w] [url]${NC}    Clone repository (interactive if no url)
                          Use ${YELLOW}-s${NC}, ${YELLOW}--tmux-session${NC} to open a session (tmux session / herdr workspace)
                          Use ${YELLOW}-w${NC}, ${YELLOW}--tmux-window${NC} to open in a new window (tmux window / herdr tab)
  ${GREEN}create, new, n${NC} ${YELLOW}[-s|-w]${NC}  Create and initialize a new repository
                          Use ${YELLOW}-s${NC}, ${YELLOW}--tmux-session${NC} to open a session (tmux session / herdr workspace)
                          Use ${YELLOW}-w${NC}, ${YELLOW}--tmux-window${NC} to open in a new window (tmux window / herdr tab)
  ${GREEN}open, o${NC} ${YELLOW}[editor]${NC}        Open repository in editor (default: \$EDITOR, then code)
  ${GREEN}help, h${NC}                 Show this help message

${CYAN}Hub mode keys${NC} ${GRAY}(bare ${NC}rp${GRAY}, or ${NC}rp hub${GRAY}):${NC}
${hub_keys}  ${GRAY}A pick that is not cloned yet is cloned first, whichever action you choose.${NC}

${CYAN}Examples:${NC}
  ${GRAY}# -s/-w auto-select the multiplexer (herdr inside herdr, otherwise tmux):${NC}
  ${GRAY}#   -s = tmux session / herdr workspace,  -w = tmux window / herdr tab${NC}
  rp                    ${GRAY}# Hub mode: pick a repository, then choose an action (enter = cd)${NC}
  rp cd                 ${GRAY}# Change to selected repository${NC}
  rp dot                ${GRAY}# Fuzzy match "dot" and cd to best match (e.g. dotfiles)${NC}
  rp cd dot             ${GRAY}# Same as above (explicit cd subcommand)${NC}
  rp cd -s              ${GRAY}# Change to selected repository in a new tmux session / herdr workspace${NC}
  rp cd -s dot          ${GRAY}# Fuzzy match + tmux session / herdr workspace${NC}
  rp cd -w              ${GRAY}# Change to selected repository in a new tmux window / herdr tab${NC}
  rp cd --tmux-session  ${GRAY}# Same as -s (long option)${NC}
  rp path               ${GRAY}# Print path of selected repository${NC}
  rp path dot           ${GRAY}# Print path of best fuzzy match (e.g. dotfiles)${NC}
  cd "\$(rp path dot)"   ${GRAY}# Use the path in command substitution${NC}
  rp get                ${GRAY}# Interactive repository selection${NC}
  rp get github.com/user/repo
  rp get -s user/repo   ${GRAY}# Clone and open in a new tmux session / herdr workspace${NC}
  rp get -w user/repo   ${GRAY}# Clone and open in a new tmux window / herdr tab${NC}
  rp get --tmux-window user/repo  ${GRAY}# Same as -w (long option)${NC}
  rp create github.com/user/new-repo
  rp create -s user/new-repo  ${GRAY}# Create and open in a new tmux session / herdr workspace${NC}
  rp create -w user/new-repo  ${GRAY}# Create and open in a new tmux window / herdr tab${NC}
  rp remove             ${GRAY}# Remove selected repository${NC}
  rp open               ${GRAY}# Open in \$RP_EDITOR, \$VISUAL, \$EDITOR, then code${NC}
  rp open vim           ${GRAY}# Open repository in vim${NC}
  rp open nvim          ${GRAY}# Open repository in neovim${NC}

${CYAN}Configuration${NC} ${GRAY}(environment variables; see README for detail):${NC}
  ${GREEN}RP_EDITOR${NC}               Editor for ${YELLOW}open${NC}, before \$VISUAL and \$EDITOR
  ${GREEN}RP_PREVIEW_CMD${NC}          Preview command. {} is host/user/repo, \$RP_ROOT the ghq root
  ${GREEN}RP_PREVIEW_REMOTE_CMD${NC}   Preview command for the GitHub listing
  ${GREEN}RP_PREVIEW_WINDOW${NC}       fzf ${YELLOW}--preview-window${NC} spec
  ${GREEN}RP_KEY_SESSION${NC} ${GREEN}RP_KEY_WINDOW${NC} ${GREEN}RP_KEY_ACTIONS${NC}
  ${GREEN}RP_KEY_NEW${NC} ${GREEN}RP_KEY_REMOVE${NC} ${GREEN}RP_KEY_TOGGLE${NC}
                          Hub mode keys, as fzf key names (letters digits -)
  ${GRAY}Export them, not just set them: the herdr popup runs rp in its own process.${NC}

${CYAN}Requirements:${NC} ghq, fzf (0.63.0+), git, gh (get and ${klabs[toggle]}), jq + herdr (for -s/-w inside herdr)
EOF
            ;;
esac
