#!/bin/zsh
#
# GitHub repository management tool
# - Require: ghq, fzf, git
#


local BOLD=$'\033[1m'
local GREEN=$'\033[0;32m'
local YELLOW=$'\033[0;33m'
local CYAN=$'\033[0;36m'
local GRAY=$'\033[38;5;242m'
local NC=$'\033[0m'

local action="${1:-cd}"
local query=""
case "$action" in
    list|l|cd|c|path|p|remove|rm|r|get|g|create|new|n|open|o|help|h)
        ;;
    -*)
        action="help"
        ;;
    *)
        query="$action"
        action="cd"
        ;;
esac

# Required commands. This file is autoloaded, so this never runs at shell startup.
if [[ "$action" != "help" ]]; then
    local -a missing=()
    local cmd
    for cmd in ghq fzf git; do
        (( $+commands[$cmd] )) || missing+=("$cmd")
    done
    if (( $#missing )); then
        print -u2 "rp: missing required command(s): ${(j:, :)missing}"
        return 1
    fi
fi

_repo_require() {
    # Same message shape as the startup check above, for commands that only
    # some subcommands need.
    local -a lacking=()
    local c
    for c in "$@"; do
        (( $+commands[$c] )) || lacking+=("$c")
    done
    (( $#lacking )) || return 0
    print -u2 "rp: missing required command(s): ${(j:, :)lacking}"
    return 1
}

_repo_tmux_open() {
    local mode="$1"
    local target_path="$2"
    local name="$(basename "$target_path")"
    name="${name//./_}"

    if [[ "$mode" == "session" ]]; then
        if tmux has-session -t "$name" 2>/dev/null; then
            echo "Session '$name' already exists. Switching to it."
        else
            tmux new-session -d -s "$name" -c "$target_path"
            echo "Created tmux session: $name"
        fi
        tmux switch-client -t "$name" 2>/dev/null || tmux attach -t "$name"
    elif [[ "$mode" == "window" ]]; then
        tmux new-window -c "$target_path"
    fi
}

_repo_parse_tmux_opt() {
    case "$1" in
        -s|--tmux-session)
            tmux_mode="session"
            return 0
            ;;
        -w|--tmux-window)
            tmux_mode="window"
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

_repo_herdr_open() {
    local mode="$1"
    local target_path="$2"
    local name="$(basename "$target_path")"
    name="${name//./_}"

    if [[ "$mode" == "session" ]]; then
        # workspace = tmux session 相当。label 一致で冪等に focus、無ければ create
        local existing
        existing=$(herdr workspace list 2>/dev/null \
            | jq -r --arg l "$name" '.result.workspaces[] | select(.label == $l) | .workspace_id' \
            | head -1)
        if [[ -n "$existing" ]]; then
            herdr workspace focus "$existing" > /dev/null
            echo "Focused herdr workspace: $name"
        else
            herdr workspace create --cwd "$target_path" --label "$name" --focus > /dev/null
            echo "Created herdr workspace: $name"
        fi
    elif [[ "$mode" == "window" ]]; then
        # tab = tmux window 相当。tmux 版同様、毎回新規
        herdr tab create --cwd "$target_path" --label "$name" --focus > /dev/null
        echo "Created herdr tab: $name"
    fi
}

_repo_mux_open() {
    local mode="$1"
    local target_path="$2"
    # herdr の中なら herdr、それ以外は tmux（in/out 両対応）
    if [[ -n "$HERDR_ENV" ]]; then
        # jq は `herdr workspace list` を読む session 側でしか使わない。
        local -a needed=(herdr)
        [[ "$mode" == "session" ]] && needed+=(jq)
        _repo_require "$needed[@]" || return 1
        _repo_herdr_open "$mode" "$target_path"
    else
        _repo_require tmux || return 1
        _repo_tmux_open "$mode" "$target_path"
    fi
}

_repo_editor_open() {
    local target_path="$1"
    local editor="${2:-code}"
    if command -v "$editor" > /dev/null; then
        "$editor" "$target_path"
    else
        echo "Editor '$editor' not found. Trying fallback editors..."
        if command -v code > /dev/null; then
            code "$target_path"
        elif command -v vim > /dev/null; then
            vim "$target_path"
        else
            echo "No suitable editor found (code, vim)"
        fi
    fi
}

_repo_open_dest() {
    # Destination axis: where a repository gets opened, independent of the
    # operation that produced it. Shared by the -s/-w branches and the hub.
    # Never call this from $(...) or a subshell: the `here` cd would be lost.
    local dest="$1"
    local target_path="$2"
    case "$dest" in
        here)
            cd "$target_path" || return 1
            ;;
        session|window)
            _repo_mux_open "$dest" "$target_path"
            ;;
        editor)
            _repo_editor_open "$target_path" "$3"
            ;;
    esac
}

_repo_qualify_host() {
    # Add github.com prefix for short form (user/repo)
    local repo_path="$1"
    local first_segment="${repo_path%%/*}"
    if [[ "$first_segment" != *.* ]]; then
        repo_path="github.com/$repo_path"
    fi
    print -r -- "$repo_path"
}

_repo_create() {
    local repo_path="$1"
    local full_path="$(ghq root)/$repo_path"
    mkdir -p "$full_path" || return 1
    git -C "$full_path" init || return 1
    echo "Created and initialized: $repo_path"
}

_repo_remove_confirmed() {
    local selected_repo="$1"
    printf "Are you sure you want to remove %s? (y/n [y]) " "$selected_repo"
    local confirm
    read -r confirm
    if [[ -z "$confirm" || "$confirm" =~ ^[Yy](es)?$ ]]; then
        rm -rf "$(ghq root)/$selected_repo"
        echo "Removed: $selected_repo"
    else
        echo "Cancelled"
    fi
}

_repo_copy_path() {
    # Print the path either way, so the value survives a missing clipboard tool.
    local target_path="$1"
    local cmd
    for cmd in pbcopy wl-copy xclip; do
        (( $+commands[$cmd] )) || continue
        case "$cmd" in
            xclip) printf %s "$target_path" | xclip -selection clipboard ;;
            *)     printf %s "$target_path" | $cmd ;;
        esac
        print -r -- "$target_path"
        return 0
    done
    print -u2 "rp: no clipboard command found (tried pbcopy, wl-copy, xclip)"
    print -r -- "$target_path"
    return 1
}

case "$action" in
    "list"|"l")
        # List all repositories with fzf selection
        local selected_repo
        selected_repo=$(ghq list | fzf --height=~20% --preview="eza $(ghq root)/{} --color=always" --preview-window=down:3:wrap)
        if [[ -n "$selected_repo" ]]; then
            echo "Selected: $selected_repo"
            echo "Path: $(ghq root)/$selected_repo"
        fi
        ;;
    "cd"|"c")
        # Change directory to selected repository
        local tmux_mode=""
        _repo_parse_tmux_opt "$2" && shift
        local fuzzy_query="${query:-$2}"
        local selected_repo
        if [[ -n "$fuzzy_query" ]]; then
            # Non-interactive fuzzy match: pick best result
            selected_repo=$(ghq list | fzf --filter="$fuzzy_query" | head -1)
        else
            # Interactive mode: open fzf selector
            selected_repo=$(ghq list | fzf --height=~20% --preview="eza $(ghq root)/{} --color=always" --preview-window=down:3:wrap)
        fi
        if [[ -n "$selected_repo" ]]; then
            _repo_open_dest "${tmux_mode:-here}" "$(ghq root)/$selected_repo"
        fi
        ;;
    "path"|"p")
        # Print the path of the selected repository (no cd; for use in $(...))
        local fuzzy_query="${query:-$2}"
        local selected_repo
        if [[ -n "$fuzzy_query" ]]; then
            # Non-interactive fuzzy match: pick best result
            selected_repo=$(ghq list | fzf --filter="$fuzzy_query" | head -1)
        else
            # Interactive mode: open fzf selector
            selected_repo=$(ghq list | fzf --height=~20% --preview="eza $(ghq root)/{} --color=always" --preview-window=down:3:wrap)
        fi
        if [[ -n "$selected_repo" ]]; then
            echo "$(ghq root)/$selected_repo"
        fi
        ;;
    "remove"|"rm"|"r")
        # Remove selected repository
        local selected_repo
        selected_repo=$(ghq list | fzf --height=50% --preview="eza $(ghq root)/{} --color=always" --preview-window=down:3:wrap --prompt="Select repository to remove: ")
        if [[ -n "$selected_repo" ]]; then
            _repo_remove_confirmed "$selected_repo"
        fi
        ;;
    "get"|"g")
        # Clone/get a new repository
        local tmux_mode=""
        _repo_parse_tmux_opt "$2" && shift
        local full_path
        if [[ -z "$2" ]]; then
            # Interactive mode: show remote repositories via gh + fzf
            local selected_repo
            selected_repo=$(gh repo list --limit 100 --json nameWithOwner --jq '.[].nameWithOwner' | fzf --height=50% --preview="gh repo view {} --json description,url,pushedAt --template '{{.description}}\n{{.url}}\nLast updated: {{.pushedAt}}'" --preview-window=down:5:wrap --prompt="Select repository to clone: ")
            if [[ -n "$selected_repo" ]]; then
                full_path="$(ghq root)/github.com/$selected_repo"
                ghq get "github.com/$selected_repo" || return 1
            fi
        else
            # Normalize URL to path format for ghq
            local repo_path="$2"
            repo_path="${repo_path#https://}"
            repo_path="${repo_path#http://}"
            repo_path="${repo_path#git@}"
            repo_path="${repo_path/://}"
            repo_path="${repo_path%.git}"
            # Remove GitHub-specific paths (/tree/branch, /blob/branch, etc.)
            repo_path="${repo_path%%/tree/*}"
            repo_path="${repo_path%%/blob/*}"
            repo_path=$(_repo_qualify_host "$repo_path")

            full_path="$(ghq root)/$repo_path"
            ghq get "$2" || return 1
        fi

        if [[ -n "$full_path" ]]; then
            _repo_open_dest "${tmux_mode:-here}" "$full_path"
        fi
        ;;
    "create"|"new"|"n")
        # Create a new repository directory
        local tmux_mode=""
        _repo_parse_tmux_opt "$2" && shift
        if [[ -z "$2" ]]; then
            echo "Usage: rp create [-s|--tmux-session|-w|--tmux-window] <repository_path>"
            echo "  -s, --tmux-session  Open in a new session (tmux session / herdr workspace)"
            echo "  -w, --tmux-window   Open in a new window (tmux window / herdr tab)"
            echo "Example: rp create user/new-repo"
            return 1
        fi
        local repo_path="$(_repo_qualify_host "$2")"
        _repo_create "$repo_path" || return 1
        _repo_open_dest "${tmux_mode:-here}" "$(ghq root)/$repo_path"
        ;;
    "open"|"o")
        # Open repository in editor (default: code)
        local editor="${2:-code}"
        local selected_repo
        selected_repo=$(ghq list | fzf --height=50% --preview="eza $(ghq root)/{} --color=always" --preview-window=down:3:wrap)
        if [[ -n "$selected_repo" ]]; then
            _repo_open_dest editor "$(ghq root)/$selected_repo" "$editor"
        fi
        ;;
    "help"|"h"|*)
        # Show help
        cat << EOF
${BOLD}Repository management with ghq and fzf${NC}

${CYAN}Usage:${NC} rp <command> [args]

${CYAN}Commands:${NC}
  ${GREEN}list, l${NC}                 List repositories with fzf selection
  ${GREEN}cd, c${NC} ${YELLOW}[-s|-w] [query]${NC}   Change directory to selected repository
                          If ${YELLOW}query${NC} is given, fuzzy match and cd to best match
                          Use ${YELLOW}-s${NC}, ${YELLOW}--tmux-session${NC} to open a session (tmux session / herdr workspace)
                          Use ${YELLOW}-w${NC}, ${YELLOW}--tmux-window${NC} to open in a new window (tmux window / herdr tab)
  ${GREEN}path, p${NC} ${YELLOW}[query]${NC}         Print path of selected repository (no cd)
                          If ${YELLOW}query${NC} is given, fuzzy match and print best match
  ${GREEN}remove, rm, r${NC}           Remove selected repository (with confirmation)
  ${GREEN}get, g${NC} ${YELLOW}[-s|-w] [url]${NC}    Clone repository (interactive if no url)
                          Use ${YELLOW}-s${NC}, ${YELLOW}--tmux-session${NC} to open a session (tmux session / herdr workspace)
                          Use ${YELLOW}-w${NC}, ${YELLOW}--tmux-window${NC} to open in a new window (tmux window / herdr tab)
  ${GREEN}create, new, n${NC} ${YELLOW}[-s|-w]${NC}  Create and initialize a new repository
                          Use ${YELLOW}-s${NC}, ${YELLOW}--tmux-session${NC} to open a session (tmux session / herdr workspace)
                          Use ${YELLOW}-w${NC}, ${YELLOW}--tmux-window${NC} to open in a new window (tmux window / herdr tab)
  ${GREEN}open, o${NC} ${YELLOW}[editor]${NC}        Open repository in editor (default: code)
  ${GREEN}help, h${NC}                 Show this help message

${CYAN}Examples:${NC}
  ${GRAY}# -s/-w auto-select the multiplexer (herdr inside herdr, otherwise tmux):${NC}
  ${GRAY}#   -s = tmux session / herdr workspace,  -w = tmux window / herdr tab${NC}
  rp                    ${GRAY}# List repositories and change to the selected repository${NC}
  rp cd                 ${GRAY}# Change to selected repository${NC}
  rp dot                ${GRAY}# Fuzzy match "dot" and cd to best match (e.g. dotfiles)${NC}
  rp cd dot             ${GRAY}# Same as above (explicit cd subcommand)${NC}
  rp cd -s              ${GRAY}# Change to selected repository in a new tmux session / herdr workspace${NC}
  rp cd -s dot          ${GRAY}# Fuzzy match + tmux session / herdr workspace${NC}
  rp cd -w              ${GRAY}# Change to selected repository in a new tmux window / herdr tab${NC}
  rp cd --tmux-session  ${GRAY}# Same as -s (long option)${NC}
  rp path               ${GRAY}# Print path of selected repository${NC}
  rp path dot           ${GRAY}# Print path of best fuzzy match (e.g. dotfiles)${NC}
  cd "\$(rp path dot)"   ${GRAY}# Use the path in command substitution${NC}
  rp get                ${GRAY}# Interactive repository selection${NC}
  rp get github.com/user/repo
  rp get -s user/repo   ${GRAY}# Clone and open in a new tmux session / herdr workspace${NC}
  rp get -w user/repo   ${GRAY}# Clone and open in a new tmux window / herdr tab${NC}
  rp get --tmux-window user/repo  ${GRAY}# Same as -w (long option)${NC}
  rp create github.com/user/new-repo
  rp create -s user/new-repo  ${GRAY}# Create and open in a new tmux session / herdr workspace${NC}
  rp create -w user/new-repo  ${GRAY}# Create and open in a new tmux window / herdr tab${NC}
  rp remove             ${GRAY}# Remove selected repository${NC}
  rp open               ${GRAY}# Open repository in code (default)${NC}
  rp open vim           ${GRAY}# Open repository in vim${NC}
  rp open nvim          ${GRAY}# Open repository in neovim${NC}

${CYAN}Requirements:${NC} ghq, fzf, git, gh (interactive get), jq + herdr (for -s/-w inside herdr)
EOF
            ;;
esac
